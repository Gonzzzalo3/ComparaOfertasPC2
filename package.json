{
  "name": "comparaofertas-pc2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test",
    "lint": "eslint .",
    "audit": "npm audit --audit-level=high",
    "check": "npm run lint && npm test && npm run audit && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.5",
    "@babel/preset-react": "^8.0.1",
    "@eslint-react/eslint-plugin": "^2.3.9",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "globals": "^17.14.0",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22"
  }
}
